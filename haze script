-- Haze Seas - Hub Complet Optimisé (Anti-Lag + Meilleur Auto Farm)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local autoFarm = false
local flying = false
local noclipping = false
local killAura = false

local flySpeed = 60
local walkSpeed = 50
local killAuraRange = 25

local selectedWeapon = nil

-- ==================== GUI DRAGGABLE ====================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "HazeHub"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 400, 0, 580)
main.Position = UDim2.new(0.5, -200, 0.5, -290)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
main.Parent = screenGui
Instance.new("UICorner", main).CornerRadius = UDim.new(0, 14)

-- Drag
local dragging = false
main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)
main.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Titre
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,55)
title.BackgroundColor3 = Color3.fromRGB(255, 120, 50)
title.Text = "🍋 Haze Seas Hub"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 22
title.Parent = main
Instance.new("UICorner", title).CornerRadius = UDim.new(0, 14)

-- Boutons
local function createButton(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9,0,0,50)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(40,40,55)
    btn.Text = text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = main
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local farmBtn = createButton("Auto Farm LVL : OFF", UDim2.new(0.05,0,0,70), function()
    autoFarm = not autoFarm
    farmBtn.Text = "Auto Farm LVL : " .. (autoFarm and "ON" or "OFF")
end)

local flyBtn = createButton("Fly : OFF", UDim2.new(0.05,0,0,130), function()
    flying = not flying
    flyBtn.Text = "Fly : " .. (flying and "ON" or "OFF")
    -- Toggle Fly logic here (same as before)
end)

local noclipBtn = createButton("Noclip : OFF", UDim2.new(0.05,0,0,190), function()
    noclipping = not noclipping
    noclipBtn.Text = "Noclip : " .. (noclipping and "ON" or "OFF")
end)

local killAuraBtn = createButton("Kill Aura : OFF", UDim2.new(0.05,0,0,250), function()
    killAura = not killAura
    killAuraBtn.Text = "Kill Aura : " .. (killAura and "ON" or "OFF")
end)

-- Weapon Select
local weaponBox = Instance.new("TextBox")
weaponBox.Size = UDim2.new(0.9,0,0,40)
weaponBox.Position = UDim2.new(0.05,0,0,320)
weaponBox.PlaceholderText = "Nom de l'arme"
weaponBox.BackgroundColor3 = Color3.fromRGB(30,30,45)
weaponBox.Parent = main
Instance.new("UICorner", weaponBox).CornerRadius = UDim.new(0, 8)

weaponBox.FocusLost:Connect(function()
    selectedWeapon = weaponBox.Text ~= "" and weaponBox.Text or nil
end)

-- ==================== FONCTIONS OPTIMISÉES ====================
local function getNearestMob()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, dist = nil, 250

    for _, obj in pairs(Workspace:GetChildren()) do -- Seulement GetChildren() pour moins de lag
        if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj.Humanoid.Health > 0 then
            if not Players:FindFirstChild(obj.Name) then
                local d = (obj.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < dist then
                    closest = obj
                    dist = d
                end
            end
        end
    end
    return closest
end

-- Auto Farm (optimisé)
RunService.Heartbeat:Connect(function()
    if not autoFarm then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local tool = selectedWeapon and char:FindFirstChild(selectedWeapon) or char:FindFirstChildOfClass("Tool")

    if hrp and tool then
        local mob = getNearestMob()
        if mob then
            hrp.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, 5, 8)
            tool:Activate()
        end
    end
end)

-- Kill Aura (optimisé)
RunService.Heartbeat:Connect(function()
    if not killAura then return end
    local char = player.Character
    if not char then return end
    local tool = selectedWeapon and char:FindFirstChild(selectedWeapon) or char:FindFirstChildOfClass("Tool")
    if not tool then return end

    for _, mob in pairs(Workspace:GetChildren()) do
        if mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
            if not Players:FindFirstChild(mob.Name) then
                local dist = (mob.HumanoidRootPart.Position - (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position or Vector3.new())).Magnitude
                if dist < killAuraRange then
                    tool:Activate()
                end
            end
        end
    end
end)

print("✅ Hub Haze Seas chargé - Tout est optimisé")
