local badNPC = {"Quest", "NPC", "Old Man", "Sailor", "Captain", "Merchant", "Villager", "Blacksmith"}

spawn(function()
    while wait(1) do
        for _, v in pairs(game.Workspace:GetDescendants()) do
            if v:FindFirstChild("Humanoid") then
                for _, name in pairs(badNPC) do
                    if v.Name:find(name) then
                        v.Humanoid.Health = 0 -- ou ignore
                    end
                end
            end
        end
    end
end)
